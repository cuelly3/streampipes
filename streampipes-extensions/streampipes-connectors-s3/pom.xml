<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.streampipes</groupId>
        <artifactId>streampipes-extensions</artifactId>
        <version>0.99.0-SNAPSHOT</version>
    </parent>

    <artifactId>streampipes-connectors-s3</artifactId>

    <!--
      Camel and AWS SDK versions are managed in the root pom, which is how this
      repository already aligns Camel across streampipes-connectors-camel and
      streampipes-connectors-camel-azure. Importing camel-bom here would be a
      second, competing source of truth for the same versions.
    -->
    <dependencies>
        <dependency>
            <groupId>org.apache.streampipes</groupId>
            <artifactId>streampipes-extensions-api</artifactId>
            <version>0.99.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.apache.streampipes</groupId>
            <artifactId>streampipes-extensions-management</artifactId>
            <version>0.99.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.apache.streampipes</groupId>
            <artifactId>streampipes-sdk</artifactId>
            <version>0.99.0-SNAPSHOT</version>
        </dependency>

        <!-- camel-core-engine, not the camel-core aggregate: the repository
             already manages the engine and this module only needs the context
             plus the aws2-s3 component. -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core-engine</artifactId>
        </dependency>
        <!-- Provides the expression languages (simple, constant, header) that
             Camel's route model resolves through the language registry, even
             for routes written entirely with Java lambdas. -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core-languages</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-aws2-s3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers core only. There is deliberately no
          org.testcontainers:minio dependency: that module does not exist for
          the Testcontainers 2.x line this build resolves, and its container
          hard-codes the withdrawn minio/minio image. Integration tests use a
          GenericContainer pinned to the same images as ../../s3-test-env.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
